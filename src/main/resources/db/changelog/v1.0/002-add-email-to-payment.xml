<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.30.xsd">

    <changeSet id="add-email-to-payment-v1.1" author="youssef">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="payment" columnName="email"/>
            </not>
        </preConditions>
        <addColumn tableName="payment">
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="payment" columnName="email"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
